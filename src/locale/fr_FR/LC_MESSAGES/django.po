#: templates/account/login.html:7
msgid "Login"
msgstr "Connexion"

#: templates/account/login.html:11
msgid "Sign in to your account"
msgstr "Connectez-vous à votre compte"

#: templates/account/login.html:28
msgid "Sign In"
msgstr "Se connecter"

#: templates/account/login.html:41
msgid "Need an account?"
